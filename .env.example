FLASK_ENV=development
FLASK_APP=run.py
# Секретный ключ для сессий и CSRF-защиты (обязательно измените!)
SECRET_KEY=your-secret-key-here-change-me
DATABASE_URI=sqlite:///db.sqlite3
# Токен Яндекс.Диска для загрузки файлов.
# Получить можно на https://oauth.yandex.ru/ с правами cloud_api:disk.app
DISK_TOKEN=your-yandex-disk-token-here